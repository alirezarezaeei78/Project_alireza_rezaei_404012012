<mujoco model="rope_arm_one_segment">
  <compiler angle="degree" coordinate="local" inertiafromgeom="true"/>

  <!-- Earth gravity + stable integrator -->
  <option timestep="0.0005" gravity="0 0 -9.81" integrator="implicitfast"
          iterations="80" ls_iterations="20"/>
  <!-- Explicit arena for this small model, replacing oversized legacy constraints. -->
  <size memory="64M"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient"
             rgb1="0.3 0.5 0.7" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge"
             rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
             markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true"
              texrepeat="5 5" reflectance="0.2"/>

    <material name="mat_metal" reflectance="0.40" rgba="0.86 0.87 0.90 1"
              shininess="0.95" specular="1.0"/>
    <material name="mat_metal_dark" reflectance="0.35" rgba="0.18 0.18 0.20 1"
              shininess="0.95" specular="1.0"/>
    <material name="mat_green_paint" reflectance="0.18" rgba="0.08 0.95 0.22 1"
              shininess="0.70" specular="0.75"/>

    <material name="mat_cable" reflectance="0.03" rgba="0.65 0.50 0.28 1"
              shininess="0.15" specular="0.15"/>
    <material name="mat_ball" reflectance="0.35" rgba="0.12 0.12 0.14 1"
              shininess="0.95" specular="1.0"/>
  </asset>

  <default>
    <geom friction="0.9 0.1 0.1"/>
    <joint damping="0.8" armature="0.02"/>

    <default class="visual">
      <geom contype="0" conaffinity="0" mass="0" density="0" group="2"/>
    </default>
  </default>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" size="0 0 0.05" material="groundplane"/>

    <!-- Stand -->
    <body name="stand" pos="0 0 1.2">
      <geom name="stand_geom" type="cylinder" size="0.30 1.20"
            material="mat_metal" rgba="0.86 0.86 0.88 1" mass="40"
            contype="0" conaffinity="0"/>

      <geom class="visual" type="cylinder" pos="0 0 1.15" size="0.32 0.02"
            material="mat_metal_dark" rgba="0.15 0.15 0.16 1"/>
      <geom class="visual" type="cylinder" pos="0 0 -0.95" size="0.32 0.02"
            material="mat_metal_dark" rgba="0.15 0.15 0.16 1"/>

      <!-- Green stick -->
      <body name="green_link" pos="0 0 1.25">
        <joint name="joint0" type="hinge" axis="0 0 1" range="-170 170"
               damping="3.0" armature="0.12"/>

        <geom class="visual" type="cylinder" pos="0 0 0" size="0.09 0.03"
              material="mat_metal_dark" rgba="0.14 0.14 0.15 1"/>

        <geom name="link1" type="capsule" fromto="0 0 0   1.00 0 0"
              size="0.05" material="mat_green_paint" rgba="0.08 0.95 0.22 1"
              mass="2.0"/>

        <geom class="visual" type="sphere" pos="1.05 0 0" size="0.055"
              material="mat_metal" rgba="0.82 0.84 0.87 1"/>

        <site name="rope_attach" pos="1.05 0 0" size="0.01" rgba="1 1 1 0"/>

        <!-- ONE-SEGMENT rigid "rope" (cannot bend) -->
        <body name="rope_rigid" pos="1.05 0 0">
          <joint name="rope_joint" type="ball" damping="0.4"/>

          <geom name="cable" type="capsule"
                fromto="0 0 0   0 0 -0.96"
                size="0.006"
                material="mat_cable"
                mass="0.02"
                contype="0" conaffinity="0"/>

          <geom name="ball" type="sphere"
                pos="0 0 -0.96"
                size="0.11"
                material="mat_ball"
                rgba="0.12 0.12 0.14 1"
                mass="0.5"
                contype="1" conaffinity="1"/>

          <site name="imu_site" pos="0 0 -0.96" size="0.01" rgba="1 0 0 0"/>

          <geom class="visual" type="cylinder" pos="0 0 -0.96"
                size="0.115 0.004" material="mat_metal"
                rgba="0.85 0.86 0.90 0.35"/>
        </body>

      </body>
    </body>
  </worldbody>

  <actuator>
    <position name="yaw_pos"
              joint="joint0"
              kp="350"
              dampratio="1.0"
              ctrlrange="-2.9670597283903604 2.9670597283903604"
              forcerange="-300 300"/>
  </actuator>

  <sensor>
    <accelerometer name="ball_acc" site="imu_site"/>
    <gyro          name="ball_gyro" site="imu_site"/>
    <framequat     name="ball_quat" objtype="site" objname="imu_site"/>
  </sensor>
</mujoco>
